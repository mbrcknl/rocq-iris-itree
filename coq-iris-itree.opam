opam-version: "1.0"
maintainer: "anonymized"

synopsis: "A framework for modularly defining program logics."

depends: [
  "coq-itree"
  "coq-iris-heap-lang" { (= "dev.2025-08-04.0.264b2923") | (= "dev") }
  "coq-elpi" { (= "2.2.3") }
  "coq-paco" { (= "4.2.1") }
  "coq-stdpp-unstable"
  "coq-record-update"
]

build: [make "-j%{jobs}%"]
install: [make "install"]
