opam-version: "1.0"
maintainer: "anonymized"

synopsis: "A framework for modularly defining program logics."

depends: [
  "coq-iris-heap-lang" { (= "dev.2024-10-03.0.4871f965") | (= "dev") }
  "coq-itree" { (= "5.1.2") }
  "coq-elpi" { (= "2.2.3") }
  "coq-paco" { (= "4.2.1") }
  "coq-stdpp-unstable"
  "coq-record-update"
]

build: [make "-j%{jobs}%"]
install: [make "install"]
