opam-version: "1.0"
maintainer: "anonymized"

synopsis: "A framework for modularly defining program logics."

depends: [
  "coq-itree"
  "coq-iris-heap-lang" { (= "dev.2025-10-16.1.060440e4") | (= "dev") }
  "coq-elpi"
  "coq-paco"
  "coq-stdpp-unstable"
  "coq-record-update"
]

build: [make "-j%{jobs}%"]
install: [make "install"]
